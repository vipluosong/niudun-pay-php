{
    "name": "niudun/pay",
    "description": "牛盾聚合支付 开放支付平台 PHP SDK（核心支付子集：pay / close / refund / query / 回调验签）",
    "type": "library",
    "keywords": ["niudun", "payment", "sdk", "alipay", "wechat"],
    "license": "Apache-2.0",
    "homepage": "https://gitee.com/qyyapp/niudun-pay-php",
    "support": {
        "issues": "https://gitee.com/qyyapp/niudun-pay-php/issues",
        "source": "https://gitee.com/qyyapp/niudun-pay-php"
    },
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "NiuDun\\OpenSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NiuDun\\OpenSdk\\Tests\\": "tests/"
        }
    }
}
